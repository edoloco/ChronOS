<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reloj_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextClock
        android:id="@+id/reloj_hora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:textColor="#FFFFFFFF"
        android:textSize="56sp" />

    <TextClock
        android:id="@+id/reloj_fecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEEE, d \'de\' MMMM"
        android:format24Hour="EEEE, d \'de\' MMMM"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFE6EDF3"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/reloj_alarma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FF5CC3CF"
        android:textSize="13sp" />
</LinearLayout>
